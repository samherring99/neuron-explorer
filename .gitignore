.venv/
__pycache__/
.DS_Store

# sweep data and derived files
runs/
stats/
captures/
logs/
explorer/cache/connections.sqlite

# third-party material
source/
tawny-owl/
ref/
scripts/mirror.log
explorer/cache/agent/
*.zip
explorer/names.json
explorer/*.local.md

# per-model caches for other checkpoints — derived at first boot, large (the 4B's precomputed caches
# above are shipped by upstream; anything under models/ is rebuilt locally)
explorer/cache/models/
explorer/names_*.json

# local experiment scripts — the branch ships ONE worked example (scripts/example_hunt.py, whose
# result is committed under examples/); everything else here stays on disk but is not committed
scripts/*.py
!scripts/example_hunt.py
